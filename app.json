{
  "expo": {
    "name": "sari-na",
    "slug": "sari-na",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sarina",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002A7A",
        "image": "./assets/images/sarina_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/sarina_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#002A7A",
      "imageWidth": 800,
      "dark": { "backgroundColor": "#002A7A" }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sarina_logo.png",
          "imageWidth": 800,
          "resizeMode": "contain",
          "backgroundColor": "#002A7A",
          "dark": { "backgroundColor": "#002A7A" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
